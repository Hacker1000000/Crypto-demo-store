# Copy to .env (or set Replit secrets)
# JWT secret used for user tokens (replace with a secure random value)
JWT_SECRET=replace-with-a-random-secret

# DB file (keeps data in the repl)
DB_FILE=./data/store.db

# Application base URL (replit url e.g. https://your-repl.username.repl.co)
APP_BASE_URL=http://localhost:3000

# Static addresses for demo-only checkout (put your test addresses here)
STATIC_BTC_ADDRESS=bc1qexamplebtcaddressxxxxxxxxxxxxxxxxxxxxxxxxxx
STATIC_XMR_ADDRESS=44examplexmraddressxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: integrated XMR payment id or instructions
STATIC_XMR_PAYMENT_ID=

# Server port (Replit sets PORT automatically; keep default)
PORT=3000
